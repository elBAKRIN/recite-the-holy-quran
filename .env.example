# ============================================================================
#  نموذج متغيّرات البيئة (Environment Variables Template)
# ----------------------------------------------------------------------------
#  انسخ هذا الملف إلى ".env" واملأ القيم الحقيقية. ملف ".env" مُستبعَد من Git
#  ولا يُرفع إطلاقاً (راجع .gitignore و SECURITY.md).
#
#  ملاحظة: مفاتيح Quran.Foundation تُحقَن في تطبيق Flutter وقت البناء عبر
#  --dart-define (وليس عبر تحميل ملف .env وقت التشغيل). انظر env.json.example
#  و OPEN_SOURCE_GUIDE.md لطريقة التمرير الفعلية.
# ============================================================================

# ---- مصدر صوتيات Quran.Foundation (quran.com) — اختياري ----
# سجّل تطبيقاً على: https://api-docs.quran.foundation/ للحصول على المفاتيح.
# إن تُركت فارغة: يعمل التطبيق بمصدر alquran.cloud فقط (يُخفى قرّاء quran.com).
QF_CLIENT_ID=
QF_CLIENT_SECRET=

# ---- (اختياري للمطوّرين) قاعدة عناوين API بديلة ----
# QF_OAUTH_BASE_URL=https://oauth2.quran.foundation
# QF_API_BASE_URL=https://apis.quran.foundation
